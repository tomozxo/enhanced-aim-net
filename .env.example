# Copy this file to .env and fill in real values before running the server.

# Secret used to sign session tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Bearer token required to call the /api/admin/* key-management endpoints.
# Treat this like a password - it lets you mint, revoke and unlock license keys.
ADMIN_TOKEN=change-this-to-a-long-random-string

# Port the server listens on.
PORT=3000

# If the site sits behind a reverse proxy / load balancer (nginx, Cloudflare,
# Render, etc.), this needs to be set so req.ip resolves to the real client
# IP instead of the proxy's IP - otherwise the license IP-lock breaks (either
# everyone looks like they share one IP, or the same visitor's IP appears to
# change between requests). Leave blank/0 for direct connections (no proxy).
# Set to "true" to trust the whole proxy chain (safe default when you don't
# know the exact number of hops - this is what render.yaml uses). Only set
# an exact number (e.g. "1") if you've verified that's really how many
# proxies sit in front of the app; guessing wrong causes IP-lock false
# mismatches like a key claiming to be "locked to a different network" for
# the same person.
TRUST_PROXY_HOPS=0
