# Copy this file to .env and fill in real values before running the server.

# Secret used to sign session tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Bearer token required to call the /api/admin/* key-management endpoints.
# Treat this like a password - it lets you mint, revoke and unlock license keys.
ADMIN_TOKEN=change-this-to-a-long-random-string

# Port the server listens on.
PORT=3000

# If the site sits behind a reverse proxy / load balancer (nginx, Cloudflare,
# Render, etc.), this needs to be set so req.ip resolves to the real client
# IP instead of the proxy's IP. The license lock itself is cookie-based, not
# IP-based, so this only affects per-IP rate limiting on activation attempts
# and correctly detecting HTTPS (so the device cookie gets the Secure flag).
# Leave blank/0 for direct connections (no proxy). Set to "true" to trust
# the whole proxy chain (safe default when you don't know the exact number
# of hops - this is what render.yaml uses). Only set an exact number (e.g.
# "1") if you've verified that's really how many proxies sit in front of
# the app.
TRUST_PROXY_HOPS=0

# Where license keys are stored. Leave unset to use a local file
# (data/keys.json) - fine for running on your own machine. In production set
# it to a Postgres connection string (e.g. Supabase's "Session pooler" one),
# so keys survive deploys and restarts. The table is created automatically.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
